{
  "name": "@dailyforge/frontend",
  "version": "0.0.0",
  "description": "DailyForge — a manual-logging fitness and habit tracker where every action becomes points.",
  "author": "Kirankumar K R <kirankumarkr5901@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirankumarkr5901/daily-forge.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "build:staging": "ng build --configuration=staging",
    "build:deploy": "node scripts/set-api-url.mjs && ng build --configuration=production",
    "test:ci": "ng test --no-watch",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.30",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.36",
    "@angular/cli": "^20.3.36",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  }
}
